            "text": "{\"result\":{\"pageHeaders\":{\"insightTitle\":\"Data Insights\",\"underMaintenanceLabel\":\"Under Maintenance\",\"impactTitle\":\"Data in Practice\",\"insightSubtitle\":\"Quick reads and key insights based on Atlas data.\",\"spotlightSubtitle\":\"Interactive data stories that empower users to explore data in a dynamic way to find answers to their specific questions.\",\"filterLabel\":\"Filter tools\",\"noResultsMessage\":\"No results found\",\"spotlightTitle\":\"Data Explorations\",\"impactSubtitle\":\"Read about how the Atlas has supported adaptation programs.\",\"upvoteLabel\":\"Upvote:\",\"comingSoonLabel\":\"Coming soon\",\"prototypeLabel\":\"Prototype\",\"notifyMeLink\":\"mailto:p.steward@cgiar.org\",\"notifyMeLabel\":\"Notify me\",\"prototypeFeedbackLink\":\"mailto:p.steward@cgiar.org\",\"searchPlaceholder\":\"Search for a topic…\",\"prototypeFeedbackLabel\":\"Provide feedback\"},\"title\":\"Home\",\"slug\":\"home\",\"relatedInfo\":{\"title3\":\"QUICK READS\",\"title\":\"Related Information\",\"title4\":\"PARTNERS\",\"content2\":[{\"style\":\"normal\",\"_key\":\"d2a386165f21\",\"markDefs\":[{\"_type\":\"link\",\"href\":\"https://adaptationatlas.cgiar.org/use-cases/iucn-gcf\",\"_key\":\"9a4f8ddac54d\"}],\"children\":[{\"text\":\"IUCN develops climate rationale for Green Climate Fund proposal with Atlas climate projections and livestock data\",\"_key\":\"95c55fb00727\",\"_type\":\"span\",\"marks\":[\"9a4f8ddac54d\"]}],\"_type\":\"block\"},{\"_type\":\"block\",\"style\":\"normal\",\"_key\":\"4199cbfd999d\",\"markDefs\":[{\"_key\":\"b5eeac385e2b\",\"_type\":\"link\",\"href\":\"https://adaptationatlas.cgiar.org/use-cases/cgiar-strategy\"}],\"children\":[{\"marks\":[\"b5eeac385e2b\"],\"text\":\"CGIAR takes strategic research portfolio decisions with Atlas' hazard response analytics\",\"_key\":\"e476d6d9733e\",\"_type\":\"span\"}]},{\"markDefs\":[{\"_key\":\"382006e3ab71\",\"_type\":\"link\",\"href\":\"https://adaptationatlas.cgiar.org/use-cases/government-kenya\"}],\"children\":[{\"_type\":\"span\",\"marks\":[\"382006e3ab71\"],\"text\":\"Kenyan county governments access data on locally relevant adaptation strategies\",\"_key\":\"41eafac1a382\"}],\"_type\":\"block\",\"style\":\"normal\",\"_key\":\"715d661612ff\"},{\"markDefs\":[{\"_type\":\"link\",\"href\":\"https://adaptationatlas.cgiar.org/use-cases/world-bank-aiccra\",\"_key\":\"4b54c5bbd175\"}],\"children\":[{\"text\":\"The World Bank assessed the viability of adaptation investments with a model integrated into the Atlas\",\"_key\":\"ca8d707316a9\",\"_type\":\"span\",\"marks\":[\"4b54c5bbd175\"]}],\"_type\":\"block\",\"style\":\"normal\",\"_key\":\"ae83382dee1a\"},{\"style\":\"normal\",\"_key\":\"161538866c55\",\"markDefs\":[{\"_type\":\"link\",\"href\":\"https://adaptationatlas.cgiar.org/use-cases/aaa-csaips\",\"_key\":\"2db8510f4a5e\"}],\"children\":[{\"text\":\"The AAA Initiative and partners developed national investment plans using Atlas data\",\"_key\":\"53d6ada04d61\",\"_type\":\"span\",\"marks\":[\"2db8510f4a5e\"]}],\"_type\":\"block\"},{\"markDefs\":[{\"_key\":\"3725ed46624a\",\"_type\":\"link\",\"href\":\"https://adaptationatlas.cgiar.org/use-cases/our-data-can-help\"}],\"children\":[{\"text\":\"Our data can help NGOs, researchers, governments, international finance institutions, and you, too.\",\"_key\":\"27b57a6dd7b00\",\"_type\":\"span\",\"marks\":[\"3725ed46624a\"]}],\"_type\":\"block\",\"style\":\"normal\",\"_key\":\"fa491464c66f\"}],\"content4\":[{\"children\":[{\"marks\":[\"4f3a8c240b7d\"],\"text\":\"Consultative Group on International Agricultural Research\",\"_key\":\"5f74957a959d\",\"_type\":\"span\"}],\"_type\":\"block\",\"style\":\"normal\",\"_key\":\"5108692bd9b4\",\"markDefs\":[{\"href\":\"https://www.cgiar.org/\",\"_key\":\"4f3a8c240b7d\",\"_type\":\"link\"}]},{\"children\":[{\"text\":\"Alliance Bioversity International and the International Center for Tropical Agriculture\",\"_key\":\"c92f3064b8c4\",\"_type\":\"span\",\"marks\