          "content": {
            "mimeType": "application/json; charset=utf-8",
            "size": 3398,
            "text": "{\"result\":{\"_id\":\"9f328a0f-2a19-4566-b194-ff4467d0480d\",\"_createdAt\":\"2025-11-17T16:03:58Z\",\"title\":\"Atlas Learning Hub\",\"slug\":\"resources\",\"introContent\":[{\"_key\":\"67f415577feb\",\"markDefs\":[],\"children\":[{\"text\":\"If you are looking for guidance on how to get started with Atlas data, have a specific question, or need clarification on Atlas terminology, you’ve come to the right place. Welcome to the Atlas Learning Hub—your one-stop shop for all training materials.\",\"_key\":\"c01829b2cfb2\",\"_type\":\"span\",\"marks\":[]}],\"_type\":\"block\",\"style\":\"normal\"},{\"children\":[{\"text\":\"Here, you’ll find explainer videos on a variety of topics, accessible audio bites, our glossary, and a collection of FAQs. All training materials have been developed based on user feedback to ensure they are tailored to real needs.\",\"_key\":\"ad0c2f0c30b4\",\"_type\":\"span\",\"marks\":[]}],\"_type\":\"block\",\"style\":\"normal\",\"_key\":\"265e53f01326\",\"markDefs\":[]},{\"_type\":\"block\",\"style\":\"normal\",\"_key\":\"034f819995f0\",\"markDefs\":[],\"children\":[{\"_type\":\"span\",\"marks\":[],\"text\":\"If you’re missing something, don’t hesitate to let us know—we intend this to be a living resource that continues to improve and grow the community of active Atlas users.\",\"_key\":\"a7a9ed4d1ae3\"}]}],\"content\":[{\"children\":[{\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Atlas Glossary\",\"_key\":\"b6941c34b46d\"}],\"_type\":\"block\",\"style\":\"normal\",\"_key\":\"a7c85fcfb9f9\",\"markDefs\":[]},{\"markDefs\":[],\"children\":[{\"marks\":[],\"text\":\"Stumbled upon a term or acronym you want to understand better? Our glossary likely has the answers. Use the table of contents to browse by topic or use the search function to look up a specific word.\",\"_key\":\"64988a646b61\",\"_type\":\"span\"}],\"_type\":\"block\",\"style\":\"normal\",\"_key\":\"2206d0402d91\"},{\"markDefs\":[{\"_key\":\"a7b54eac5716\",\"_type\":\"link\",\"href\":\"https://adaptationatlas.github.io/atlas_notebooks/docs/glossary\"}],\"children\":[{\"text\":\"Visit here\",\"_key\":\"7136c1d998b6\",\"_type\":\"span\",\"marks\":[\"a7b54eac5716\"]}],\"_type\":\"block\",\"style\":\"normal\",\"_key\":\"e4a383189c5f\"},{\"style\":\"normal\",\"_key\":\"8645754d2333\",\"markDefs\":[],\"children\":[{\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"\",\"_key\":\"b674af67e811\"}],\"_type\":\"block\"},{\"markDefs\":[],\"children\":[{\"text\":\"Frequently Asked Questions\",\"_key\":\"01442ec9e078\",\"_type\":\"span\",\"marks\":[\"strong\"]}],\"_type\":\"block\",\"style\":\"normal\",\"_key\":\"a5748a363ef6\"},{\"children\":[{\"text\":\"Frequently Asked Questions\",\"_key\":\"8aff2964c995\",\"_type\":\"span\",\"marks\":[\"strong\"]}],\"_type\":\"block\",\"style\":\"normal\",\"_key\":\"f251ceca3573\",\"markDefs\":[]},{\"style\":\"normal\",\"_key\":\"dc00f7d93b97\",\"markDefs\":[],\"children\":[{\"text\":\"Have a question? Maybe someone has asked the same one! \",\"_key\":\"dd31ef1c6655\",\"_type\":\"span\",\"marks\":[]}],\"_type\":\"block\"},{\"children\":[{\"text\":\"Check out our \",\"_key\":\"180df50742d1\",\"_type\":\"span\",\"marks\":[]},{\"_type\":\"span\",\"marks\":[\"a428a3e5ff7a\"],\"text\":\"FAQ\",\"_key\":\"4259ed310916\"}],\"_type\":\"block\",\"style\":\"normal\",\"_key\":\"35f245fa3017\",\"markDefs\":[{\"_type\":\"link\",\"href\":\"https://adaptationatlas.github.io/atlas_notebooks/docs/faq\",\"_key\":\"a428a3e5ff7a\"}]},{\"_key\":\"9e1edc9f0f7b\",\"markDefs\":[],\"children\":[{\"text\":\"\",\"_key\":\"b539c41fc84c\",\"_type\":\"span\",\"marks\":[]}],\"_type\":\"block\",\"style\":\"normal\"},{\"style\":\"normal\",\"_key\":\"b26a1b48f1bd\",\"markDefs\":[],\"children\":[{\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Atlas Communications\",\"_key\":\"d516fd127144\"}],\"_type\":\"block\"},{\"_type\":\"block\",\"style\":\"normal\",\"_key\":\"89464034cb94\",\"markDefs\":[],\"children\":[{\"_key\":\"8da1e46269ad\",\"_type\":\"span\",\"marks\":[],\"text\":\"We release a newsletter for the Atlas to address big updates, new stories, and other exciting news. Find them here:\"}]},{\"listItem\":\"bullet\",\"markDefs\":[{\"_type\":\"link\",\"href\":\"https://digital-atlas.s3.amazonaws.com/atlas_comms/AAAA_Newsletter_2025-08.pdf\",\"_key\":\"3904cc6d035d\"}],\"children\":[{\"_type\":\"span\",\"marks\":[\"3904cc6d035d\"],\"text\":\"August/September 2025\",\"_key\":\"adf8b408b0bc\"}],\"level\":1,\"_type\":\"block\",\"style\":\"normal\",\"_key\":\"b943ed63d185\"},{\"_type\":\"block\",\"style\":\"normal\",\"_key\":\"1fddf51f066e\",\"markDefs\":[{\"_type\":\"link\",\"href\":\"https://digital-atlas.s3.amazonaws.com/atlas_comms/AAAA_StrategicUseCases.pdf\",\"_key\":\"946c73b659e1\"}],\"children\":[{\"_key\":\"35baa0c2cddc\",\"_type\":\"span\",\"marks\":[],\"text\":\"Read about how some of our use-case partners are using the Atlas \"},{\"marks\":[\"946c73b659e1\"],\"text\":\"here\",\"_key\":\"dd2d9c12662c\",\"_type\":\"span\"}]},{\"_type\":\"block\",\"style\":\"normal\",\"_key\":\"9c788de78031\",\"markDefs\":[{\"_type\":\"link\",\"href\":\"https://digital-atlas.s3.amazonaws.com/atlas_comms/AAAA_OverviewPoster.pdf\",\"_key\":\"41f33702eab4\"}],\"children\":[{\"marks\":[],\"text\":\"View the \",\"_key\":\"e38bf798b4ac\",\"_type\":\"span\"},{\"_type\":\"span\",\"marks\":[\"41f33702eab4\"],\"text\":\"project overview poster\",\"_key\":\"1ba6ec4ce4bf\"},{\"text\":\" for an visual overview of the Atlas, why it exists, and how it can be used.\",\"_key\":\"b96aafb404fb\",\"_type\":\"span\",\"marks\":[]}]},{\"_key\":\"8b89a4389c7d\",\"markDefs\":[],\"children\":[{\"text\":\"\",\"_key\":\"7ac545b5bed6\",\"_type\":\"span\",\"marks\":[]}],\"_type\":\"block\",\"style\":\"normal\"},{\"markDefs\":[],\"children\":[{\"_key\":\"316d5e3e46cf\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Further Resources\"}],\"_type\":\"block\",\"style\":\"normal\",\"_key\":\"e021272b6043\"},{\"style\":\"normal\",\"_key\":\"d2fd2ceaacd5\",\"markDefs\":[],\"children\":[{\"marks\":[],\"text\":\"We encourage you to explore resources and datasets on climate adaptation and agriculture. Some of these have successfully integrated Atlas data.\",\"_key\":\"e2a528d7433e\",\"_type\":\"span\"}],\"_type\":\"block\"},{\"_key\":\"4f7279337954\",\"listItem\":\"bullet\",\"markDefs\":[{\"_type\":\"link\",\"href\":\"https://acasa-bisa.org/\",\"_key\":\"55d9dbb9c385\"}],\"children\":[{\"marks\":[\"55d9dbb9c385\"],\"text\":\"ACASA - Atlas of Climate Adaptation in South Asian Agriculture\",\"_key\":\"a74427b5c557\",\"_type\":\"span\"}],\"level\":1,\"_type\":\"block\",\"style\":\"normal\"},{\"children\":[{\"text\":\"Better Planet Laboratory\",\"_key\":\"08c552bd120b\",\"_type\":\"span\",\"marks\":[\"f2edc48bb528\"]}],\"level\":1,\"_type\":\"block\",\"style\":\"normal\",\"_key\":\"020e51e4b042\",\"listItem\":\"bullet\",\"markDefs\":[{\"_type\":\"link\",\"href\":\"https://betterplanetlab.com/\",\"_key\":\"f2edc48bb528\"}]},{\"style\":\"normal\",\"_key\":\"dfa7e011c614\",\"listItem\":\"bullet\",\"markDefs\":[{\"_type\":\"link\",\"href\":\"https://climateanalytics.org/tools\",\"_key\":\"d63e756c67e4\"}],\"children\":[{\"marks\":[\"d63e756c67e4\"],\"text\":\"Climate Analytics\",\"_key\":\"6b6b5647a377\",\"_type\":\"span\"}],\"level\":1,\"_type\":\"block\"},{\"_key\":\"e6f34aa0ff42\",\"listItem\":\"bullet\",\"markDefs\":[{\"_type\":\"link\",\"href\":\"https://interactive.carbonbrief.org/climate-adaptation-papers/index.html?utm_content=bufferec9ad\\u0026utm_medium=social\\u0026utm_source=twitter.com\\u0026utm_campaign=buffer\",\"_key\":\"9009e587d991\"}],\"children\":[{\"marks\":[\"9009e587d991\"],\"text\":\"Carbon Brief\",\"_key\":\"a5c0e45f001c\",\"_type\":\"span\"}],\"level\":1,\"_type\":\"block\",\"style\":\"normal\"},{\"style\":\"normal\",\"_key\":\"371763ea8b26\",\"listItem\":\"bullet\",\"markDefs\":[{\"_type\":\"link\",\"href\":\"https://alliancebioversityciat.org/publications-data/climate-resilience-platform-and-aclimatar-adaptation-tools-empower-400-companies\",\"_key\":\"dfc8eefc77ea\"}],\"children\":[{\"text\":\"Talsma, T. (2024). Case Study: Climate resilience platform and ACLIMATAR adaptation tools empower 400+ companies to build climate-resilient agricultural supply chains.\",\"_key\":\"656ba4891f66\",\"_type\":\"span\",\"marks\":[\"dfc8eefc77ea\"]}],\"level\":1,\"_type\":\"block\"},{\"listItem\":\"bullet\",\"markDefs\":[{\"_type\":\"link\",\"href\":\"https://crva.jcdevops.com/pt/\",\"_key\":\"14a6b4615ae9\"}],\"children\":[{\"marks\":[\"14a6b4615ae9\"],\"text\":\"Mozambique Portal for Climate Risk and Vulnerability Evaluation (CRVA)\",\"_key\":\"4c3b25b0d6da\",\"_type\":\"span\"}],\"level\":1,\"_type\":\"block\",\"style\":\"normal\",\"_key\":\"52c27adfe6b6\"},{\"style\":\"normal\",\"_key\":\"d553c3ea9517\",\"listItem\":\"bullet\",\"markDefs\":[{\"href\":\"https://hdl.handle.net/10568/135825\",\"_key\":\"9404131b3c9c\",\"_type\":\"link\"}],\"children\":[{\"_key\":\"021d969c6169\",\"_type\":\"span\",\"marks\":[\"9404131b3c9c\"],\"text\":\"Vyas, S., Chilambe, P., Ghosh, A., Girvetz, E. and Ramirez-Villegas, J. 2023. Unlocking green finance for dairy smallholders: A novel climate-credit risk scoring tool to help financial providers target finance and adaptation pathways for dairy farmers in Kenya. Innovation Brief. Montpellier, France: CGIAR System Organization.\"}],\"level\":1,\"_type\":\"block\"},{\"children\":[{\"_type\":\"span\",\"marks\":[],\"text\":\"If you have remaining open questions or are interested in a topic that we haven’t covered, don’t hesitate to reach out to the Atlas team. We’ll try our best to help.\",\"_key\":\"73f3a34cceed\"}],\"_type\":\"block\",\"style\":\"normal\",\"_key\":\"ec17ae74f7e1\",\"markDefs\":[]}],\"videosSection\":{\"title\":\"Video Guides\",\"description\":\"Dive into our explainer videos below. We arranged them in a sequence that naturally guides you through a step-by-step exploration of the Atlas interface, notebooks, and core functionalities.\",\"videos\":[{\"src\":\"https://www.loom.com/embed/4338f2b575b0479282770f5c0868d003\",\"title\":\"Africa Agriculture Adaptation Atlas Overview\",\"embedCode\":\"\\u003cdiv style=\\\"position: relative; padding-bottom: 62.06896551724138%; height: 0;\\\"\\u003e\\u003ciframe src=\\\"https://www.loom.com/embed/4338f2b575b0479282770f5c0868d003?autoplay=false\\\" frameborder=\\\"0\\\" webkitallowfullscreen mozallowfullscreen allowfullscreen style=\\\"position: absolute; top: 0; left: 0; width: 100%; height: 100%;\\\"\\u003e\\u003c/iframe\\u003e\\u003c/div\\u003e\"},{\"embedCode\":\"\\u003cdiv style=\\\"position: relative; padding-bottom: 62.06896551724138%; height: 0;\\\"\\u003e\\u003ciframe src=\\\"https://www.loom.com/embed/f5366559ebc648b48a9a78a0e2b5d607?autoplay=false\\\" frameborder=\\\"0\\\" webkitallowfullscreen mozallowfullscreen allowfullscreen style=\\\"position: absolute; top: 0; left: 0; width: 100%; height: 100%;\\\"\\u003e\\u003c/iframe\\u003e\\u003c/div\\u003e\",\"src\":\"https://www.loom.com/embed/f5366559ebc648b48a9a78a0e2b5d607\",\"title\":\"Exploring the Adatpation Atlas\"},{\"title\":\"Walkthrough the Atlas Data Explorations\",\"embedCode\":\"\\u003cdiv style=\\\"position: relative; padding-bottom: 56.25%; height: 0;\\\"\\u003e\\u003ciframe src=\\\"https://www.loom.com/embed/37ffeeffd4ee4b18895a5ccbbcc95f5e?autoplay=false\\\" frameborder=\\\"0\\\" webkitallowfullscreen mozallowfullscreen allowfullscreen style=\\\"position: absolute; top: 0; left: 0; width: 100%; height: 100%;\\\"\\u003e\\u003c/iframe\\u003e\\u003c/div\\u003e\",\"src\":\"https://www.loom.com/embed/37ffeeffd4ee4b18895a5ccbbcc95f5e\"},{\"embedCode\":\"\\u003cdiv style=\\\"padding:56.25% 0 0 0;position:relative;\\\"\\u003e\\u003ciframe src=\\\"https://player.vimeo.com/video/1147595184?badge=0\\u0026amp;autopause=0\\u0026amp;player_id=0\\u0026amp;app_id=58479\\\" frameborder=\\\"0\\\" allow=\\\"autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media; web-share\\\" referrerpolicy=\\\"strict-origin-when-cross-origin\\\" style=\\\"position:absolute;top:0;left:0;width:100%;height:100%;\\\" title=\\\"Explainer Video_Use Cases\\\"\\u003e\\u003c/iframe\\u003e\\u003c/div\\u003e\\u003cscript src=\\\"https://player.vimeo.com/api/player.js\\\"\\u003e\\u003c/script\\u003e\",\"src\":\"https://player.vimeo.com/video/1147595184\",\"title\":\"Walkthrough the Adaptation Atlas Use-cases\"}]}},\"ms\":10}"
